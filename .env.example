# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# On Render, set each of these as an Environment Variable instead of a file.
# See docs/SETUP.md for step-by-step instructions on getting each value.
# ---------------------------------------------------------------------------

# 1. Telegram bot token from @BotFather (looks like 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# 2. A secret you invent — used to secure the webhook path. Any random string.
#    e.g. run:  python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=

# 3. Your Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=

# 4. The Claude model used to read your screenshots.
#    Options (cheaper -> pricier): claude-haiku-4-5, claude-sonnet-5, claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5

# 5. Google Sheet ID — the long string in your sheet's URL between /d/ and /edit
GOOGLE_SHEET_ID=

# 6. The FULL contents of your Google service-account JSON key, on ONE line.
#    (Open the downloaded .json file, copy everything, paste it here as-is.)
GOOGLE_CREDENTIALS_JSON=

# 7. (Optional) Restrict the bot to your own Telegram user ID(s), comma-separated.
#    Leave blank to allow anyone who finds the bot. Get your ID from @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=

# 8. (Auto-set by Render) The public URL of this service. Only set manually
#    for local testing with a tunnel (e.g. ngrok). Render provides this itself.
# RENDER_EXTERNAL_URL=
